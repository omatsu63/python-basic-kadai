        "class Human:\n",
        "  def __init__(self,name,age):\n",
        "    self.name = name\n",
        "    self.age = age\n",
        "\n",
        "  def printinfo(self):\n",
        "    print(self.name)\n",
        "    print(self.age)\n",
        "\n",
        "human1 = Human(\"田中\", 25)\n",
        "human2 = Human(\"松田\", 30)\n",
        "\n",
        "human1.printinfo()\n",
        "human2.printinfo()\n"
      ]
    }
  ]
